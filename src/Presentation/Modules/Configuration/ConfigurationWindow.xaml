<Window x:Class="SysTools.Presentation.Modules.Configuration.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Configuración" Width="980" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        PreviewKeyDown="OnPreviewKeyDown" Closing="OnClosing" Closed="OnClosed">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Configuración del sistema" FontSize="26" FontWeight="Bold"/>
    <StackPanel Grid.Row="1" Margin="0,8,0,14" automation:AutomationProperties.LiveSetting="Polite">
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
      <ItemsControl ItemsSource="{Binding ValidationIssues}" Margin="0,4,0,0">
        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#FFB42318" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <ScrollViewer x:Name="ConfigurationScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,14">
          <StackPanel>
            <TextBlock Text="Conexión" Style="{DynamicResource SectionTitleStyle}"/>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel><Label Content="_Servidor" Target="{Binding ElementName=HostInput}"/><TextBox x:Name="HostInput" Text="{Binding IpEmpresa, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource CaptureFieldStyle}" automation:AutomationProperties.Name="Servidor"/></StackPanel>
              <StackPanel Grid.Column="2"><Label Content="_Usuario" Target="{Binding ElementName=UserInput}"/><TextBox x:Name="UserInput" Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource CaptureFieldStyle}"/></StackPanel>
              <StackPanel Grid.Row="1" Grid.ColumnSpan="3"><Label Content="_Base de datos" Target="{Binding ElementName=DatabaseInput}"/><DockPanel><Button DockPanel.Dock="Right" Content="E_xaminar" Click="OnBrowseDatabase" IsEnabled="{Binding IsIdle}" Margin="10,0,0,0" Padding="14,7"/><TextBox x:Name="DatabaseInput" Text="{Binding RutaEmpresa, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource CaptureFieldStyle}"/></DockPanel></StackPanel>
              <StackPanel Grid.Row="2" Grid.ColumnSpan="3"><Label Content="_Nueva contraseña" Target="{Binding ElementName=PasswordInput}"/><PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" MinHeight="44" Padding="14,10" MaxLength="256"/><TextBlock Text="{Binding CredentialStatus}" Style="{DynamicResource MutedTextStyle}" Margin="0,5,0,0"/></StackPanel>
            </Grid>
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,14">
          <StackPanel><TextBlock Text="Preferencias" Style="{DynamicResource SectionTitleStyle}"/>
            <WrapPanel Margin="0,14,0,0">
              <StackPanel Width="240" Margin="0,0,18,12"><Label Content="_Ambiente"/><ComboBox SelectedValue="{Binding Ambiente}" SelectedValuePath="Tag"><ComboBoxItem Content="Pruebas" Tag="a"/><ComboBoxItem Content="Producción" Tag="b"/></ComboBox></StackPanel>
              <StackPanel Width="240" Margin="0,0,18,12"><Label Content="_Formato de precio"/><ComboBox SelectedValue="{Binding FormatoPrecio}" SelectedValuePath="Tag"><ComboBoxItem Content="México" Tag="MX"/><ComboBoxItem Content="Colombia" Tag="CO"/></ComboBox></StackPanel>
              <StackPanel Width="180"><Label Content="_Columnas" Target="{Binding ElementName=ColumnsInput}"/><ComboBox x:Name="ColumnsInput" ItemsSource="{Binding ColumnOptions}" SelectedItem="{Binding Columnas}"/></StackPanel>
            </WrapPanel>
            <Label Content="_Información adicional" Target="{Binding ElementName=InformationInput}"/><TextBox x:Name="InformationInput" Text="{Binding Informacion, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,0,14">
          <StackPanel><TextBlock Text="Licencia y equipo" Style="{DynamicResource SectionTitleStyle}"/>
            <DockPanel Margin="0,12,0,0"><Button DockPanel.Dock="Right" Content="_Copiar UUID" Click="OnCopyUuid" IsEnabled="{Binding IsIdle}" Padding="14,7"/><TextBox Text="{Binding HardwareId}" IsReadOnly="True" automation:AutomationProperties.Name="UUID del equipo"/></DockPanel>
            <Button Content="_Importar licencia" Click="OnImportLicense" IsEnabled="{Binding IsIdle}" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="14,7"/>
            <TextBlock Text="{Binding LicenseStatus}" Style="{DynamicResource MutedTextStyle}" Margin="0,8,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource CardBorderStyle}">
          <StackPanel><TextBlock Text="Impresión futura" Style="{DynamicResource SectionTitleStyle}"/>
            <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel><Label Content="_Impresora"/><ComboBox ItemsSource="{Binding Printers}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding Impresora}"/></StackPanel>
              <StackPanel Grid.Column="2"><Label Content="_Plantilla"/><ComboBox ItemsSource="{Binding Templates}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding Reporte}"/></StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ProgressBar Width="120" Height="8" IsIndeterminate="True" automation:AutomationProperties.Name="Operación de configuración en curso"><ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar>
      <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="TestButton" Content="_Probar conexión" Click="OnTestConnection" IsEnabled="{Binding IsIdle}" Padding="16,8"/><Button x:Name="SaveButton" Content="_Guardar" Click="OnSave" IsEnabled="{Binding IsIdle}" Margin="10,0,0,0" Padding="16,8"/><Button x:Name="CancelButton" Content="_Cancelar" Click="OnCancel" IsEnabled="{Binding IsIdle}" Margin="10,0,0,0" Padding="16,8"/></StackPanel>
    </Grid>
  </Grid>
</Window>
