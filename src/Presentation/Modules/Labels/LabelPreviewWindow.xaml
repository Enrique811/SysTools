<Window x:Class="SysTools.Presentation.Modules.Labels.LabelPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Vista previa de etiquetas" Width="1000" Height="650" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" PreviewKeyDown="OnPreviewKeyDown">
  <Grid Margin="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="Vista previa de etiquetas" FontSize="24" FontWeight="Bold"/><TextBlock Text="{Binding Summary}" Margin="0,6,0,12" automation:AutomationProperties.LiveSetting="Polite"/></StackPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FFE9EDF2">
      <Border Background="White" Padding="12" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Image Source="{Binding Image}" Stretch="None"><Image.LayoutTransform><ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/></Image.LayoutTransform></Image>
      </Border>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal"><TextBlock Text="Zoom" VerticalAlignment="Center"/><Slider Minimum="0.25" Maximum="3" Value="{Binding Zoom}" Width="220" Margin="12,0,0,0" automation:AutomationProperties.Name="Zoom de vista previa"/></StackPanel>
      <Button Grid.Column="1" Content="_Cerrar" IsDefault="True" Click="OnClose" Padding="18,8"/>
    </Grid>
  </Grid>
</Window>
