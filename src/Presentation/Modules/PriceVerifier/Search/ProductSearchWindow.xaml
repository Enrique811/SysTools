<Window x:Class="SysTools.Presentation.Modules.PriceVerifier.Search.ProductSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="Buscar producto" Width="860" Height="560" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Loaded="OnLoaded" Closed="OnClosed">
  <Window.InputBindings>
    <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
  </Window.InputBindings>
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock Text="Buscar producto" FontSize="24" FontWeight="Bold" />
    <Grid Grid.Row="1" Margin="0,18,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="SearchInput" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               MaxLength="256" MinHeight="36" VerticalContentAlignment="Center"
               automation:AutomationProperties.Name="Inicio de la descripcion">
        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings>
      </TextBox>
      <Button Grid.Column="1" Content="Buscar" Command="{Binding SearchCommand}" Margin="12,0,0,0" Padding="20,7"/>
    </Grid>
    <Grid Grid.Row="2" Margin="0,0,0,12">
      <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" automation:AutomationProperties.LiveSetting="Polite"/>
      <ProgressBar Width="100" Height="7" HorizontalAlignment="Right" IsIndeterminate="True" automation:AutomationProperties.Name="Busqueda en curso">
        <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
      </ProgressBar>
    </Grid>
    <DataGrid x:Name="ResultsGrid" Grid.Row="3" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
              AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
              MouseDoubleClick="OnResultsDoubleClick" automation:AutomationProperties.Name="Resultados de productos">
      <DataGrid.InputBindings><KeyBinding Key="Enter" Command="{Binding SelectCommand}"/></DataGrid.InputBindings>
      <DataGrid.Columns>
        <DataGridTextColumn Header="Codigo" Binding="{Binding Barcode}" Width="150"/>
        <DataGridTextColumn Header="Descripcion" Binding="{Binding Description}" Width="*"/>
        <DataGridTextColumn Header="Precio" Binding="{Binding FormattedPrice}" Width="120"/>
        <DataGridTextColumn Header="Existencia" Binding="{Binding Stock}" Width="130"/>
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Cancelar" Command="{Binding CancelCommand}" Padding="18,7"/>
      <Button Content="Seleccionar" Command="{Binding SelectCommand}" Margin="12,0,0,0" Padding="18,7" IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
