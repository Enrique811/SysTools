<UserControl x:Class="SysTools.Presentation.Modules.PriceVerifier.Views.PriceVerifierView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
             Loaded="OnLoaded" Unloaded="OnUnloaded">
  <UserControl.InputBindings>
    <KeyBinding Key="Enter" Command="{Binding SubmitBarcodeCommand}" />
    <KeyBinding Key="F7" Modifiers="Control" Command="{Binding OpenSearchCommand}" />
  </UserControl.InputBindings>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="{Binding ModuleTitle}" FontSize="{DynamicResource TitleFontSize}" FontWeight="Bold"/><TextBlock Text="{Binding ModuleDescription}" Style="{DynamicResource MutedTextStyle}" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Buscar" Command="{Binding OpenSearchCommand}" IsEnabled="{Binding IsSearchAvailable}" Padding="16,7" automation:AutomationProperties.HelpText="Abrir búsqueda de productos (Ctrl+F7)"/><Button Content="Imprimir" Style="{DynamicResource PlaceholderButtonStyle}" IsEnabled="{Binding IsPrintAvailable}" IsTabStop="False"/><Button Content="Configuración" Style="{DynamicResource PlaceholderButtonStyle}" IsEnabled="{Binding IsSettingsAvailable}" IsTabStop="False"/></StackPanel>
    </Grid>
    <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Margin="0,20,0,12" Padding="18">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,14,0">
          <Label Content="Código de barras" FontWeight="SemiBold" Target="{Binding ElementName=BarcodeInput}" Padding="0,0,0,8"/>
          <TextBox x:Name="BarcodeInput" Text="{Binding Barcode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource CaptureFieldStyle}" IsEnabled="{Binding IsBarcodeAvailable}" MaxLength="51" automation:AutomationProperties.Name="Código de barras" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="14,0,0,0">
          <TextBlock Text="Información adicional" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBox Text="{Binding AdditionalInformation, Mode=OneWay}" Style="{DynamicResource DisabledFieldStyle}" IsReadOnly="True" automation:AutomationProperties.Name="Información adicional"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Row="2" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding StatusMessage.Text}" TextWrapping="Wrap" automation:AutomationProperties.Name="{Binding StatusMessage.AccessibilityLabel}" automation:AutomationProperties.LiveSetting="Polite"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <ProgressBar Width="100" Height="8" IsIndeterminate="True" automation:AutomationProperties.Name="Operación en curso">
          <ProgressBar.Style><Style TargetType="ProgressBar"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style>
        </ProgressBar>
        <Button Content="Reintentar" Command="{Binding RetryCommand}" Margin="14,0,0,0" Padding="16,7"/>
      </StackPanel>
    </Grid>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>
      <Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,18,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Detalles del producto" Style="{DynamicResource SectionTitleStyle}"/><Grid Grid.Row="1" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,20,18"><TextBlock Text="Descripción" Style="{DynamicResource MutedTextStyle}"/><TextBlock Text="{Binding ProductDescription}" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,0,18"><TextBlock Text="Presentación" Style="{DynamicResource MutedTextStyle}"/><TextBlock Text="{Binding ProductPresentation}" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="Existencia" Style="{DynamicResource MutedTextStyle}"/><TextBlock Text="{Binding StockDisplay}" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Grid></Grid></Border>
      <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" CornerRadius="16" Padding="24"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Precio final" Foreground="White" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding FinalPriceDisplay}" Foreground="White" FontSize="48" FontWeight="Bold" Margin="0,14,0,0" TextWrapping="Wrap"/></StackPanel></Border>
    </Grid>
  </Grid>
</UserControl>
