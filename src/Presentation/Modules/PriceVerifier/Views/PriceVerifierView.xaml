<UserControl x:Class="SysTools.Presentation.Modules.PriceVerifier.Views.PriceVerifierView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ModuleTitle}" FontSize="{DynamicResource TitleFontSize}" FontWeight="Bold"/><TextBlock Text="{Binding ModuleDescription}" Style="{DynamicResource MutedTextStyle}" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Buscar" Style="{DynamicResource PlaceholderButtonStyle}" IsEnabled="{Binding IsSearchAvailable}" IsTabStop="False"/><Button Content="Imprimir" Style="{DynamicResource PlaceholderButtonStyle}" IsEnabled="{Binding IsPrintAvailable}" IsTabStop="False"/><Button Content="Configuración" Style="{DynamicResource PlaceholderButtonStyle}" IsEnabled="{Binding IsSettingsAvailable}" IsTabStop="False"/></StackPanel></Grid>
    <Border Grid.Row="1" Style="{DynamicResource CardBorderStyle}" Margin="0,24,0,18" Padding="22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="Código de barras" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox Text="{Binding Barcode, Mode=OneWay}" Style="{DynamicResource DisabledFieldStyle}" IsEnabled="{Binding IsBarcodeAvailable}"/></StackPanel><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="Información adicional" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBox Text="{Binding AdditionalInformation, Mode=OneWay}" Style="{DynamicResource DisabledFieldStyle}" IsEnabled="{Binding IsAdditionalInformationAvailable}"/></StackPanel></Grid></Border>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions><Border Style="{DynamicResource CardBorderStyle}" Margin="0,0,18,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Detalles del producto" Style="{DynamicResource SectionTitleStyle}"/><Grid Grid.Row="1" Margin="0,26,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,0,20,24"><TextBlock Text="Descripción" Style="{DynamicResource MutedTextStyle}"/><TextBlock Text="{Binding ProductDescription}" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,0,24"><TextBlock Text="Presentación" Style="{DynamicResource MutedTextStyle}"/><TextBlock Text="{Binding ProductPresentation}" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Row="1"><TextBlock Text="Existencia" Style="{DynamicResource MutedTextStyle}"/><TextBlock Text="{Binding StockDisplay}" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel></Grid></Grid></Border><Border Grid.Column="1" Background="{DynamicResource AccentBrush}" CornerRadius="16" Padding="28"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="Precio final" Foreground="White" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding FinalPriceDisplay}" Foreground="White" FontSize="52" FontWeight="Bold" Margin="0,16,0,0"/><TextBlock Text="Sin consulta activa" Foreground="#DBEAFE" Margin="0,12,0,0"/></StackPanel></Border></Grid>
  </Grid>
</UserControl>
