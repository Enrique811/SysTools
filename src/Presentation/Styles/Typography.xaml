<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <FontFamily x:Key="ApplicationFontFamily">Segoe UI</FontFamily>
    <sys:Double x:Key="TitleFontSize" xmlns:sys="clr-namespace:System;assembly=System.Runtime">30</sys:Double>
    <sys:Double x:Key="SectionTitleFontSize" xmlns:sys="clr-namespace:System;assembly=System.Runtime">17</sys:Double>
    <sys:Double x:Key="BodyFontSize" xmlns:sys="clr-namespace:System;assembly=System.Runtime">15</sys:Double>
    <sys:Double x:Key="SmallFontSize" xmlns:sys="clr-namespace:System;assembly=System.Runtime">13</sys:Double>
</ResourceDictionary>
