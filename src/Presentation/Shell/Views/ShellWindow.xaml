<Window x:Class="SysTools.Presentation.Shell.Views.ShellWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore" Title="SysTools" Width="1440" Height="860" MinWidth="1280" MinHeight="720" WindowStartupLocation="CenterScreen">
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SidebarBackgroundBrush}" Padding="20,24,20,18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Margin="8,0,8,30"><TextBlock Text="{Binding ApplicationName}" Foreground="White" FontSize="27" FontWeight="Bold"/><TextBlock Text="{Binding ApplicationSubtitle}" Foreground="{DynamicResource SidebarTextBrush}" FontSize="13"/></StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="UTILERÍAS" Foreground="{DynamicResource SidebarTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="12,0,0,8"/>
        <ItemsControl ItemsSource="{Binding UtilityModules}"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{DynamicResource NavigationButtonStyle}" IsEnabled="{Binding IsEnabled}" Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"><Grid Width="190"><Grid.ColumnDefinitions><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="Selection" Background="Transparent" CornerRadius="3"/><TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextWrapping="Wrap" Margin="12,0,0,0"/></Grid></Button><DataTemplate.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Selection" Property="Background" Value="{DynamicResource AccentBrush}"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="ADMINISTRACIÓN" Foreground="{DynamicResource SidebarTextBrush}" FontSize="11" FontWeight="SemiBold" Margin="12,30,0,8"/>
        <Button Content="Configuración" Style="{DynamicResource NavigationButtonStyle}" Command="{Binding OpenConfigurationCommand}" automation:AutomationProperties.HelpText="Abrir configuración del sistema"/>
        <ItemsControl ItemsSource="{Binding AdministrationModules}"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{DynamicResource NavigationButtonStyle}" IsEnabled="{Binding IsEnabled}" Command="{Binding DataContext.SelectModuleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"><TextBlock Text="{Binding DisplayName}" TextWrapping="Wrap"/></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel></ScrollViewer><TextBlock Grid.Row="2" Text="Base operativa · .NET 10" Foreground="{DynamicResource SidebarTextBrush}" FontSize="11" Margin="8,18,8,0"/>
    </Grid></Border>
    <Grid Grid.Column="1" Background="{DynamicResource MainBackgroundBrush}"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions><ContentControl Content="{Binding ActiveModuleContent}" Margin="34,28,34,24"/>
      <Border Grid.Row="1" Background="White" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Padding="28,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding ConnectionStatusText}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,26,0"/><TextBlock Grid.Column="1" Text="{Binding LicenseStatusText}" VerticalAlignment="Center" FontWeight="SemiBold"/><Border Grid.Column="2" Background="{DynamicResource StatusInfoBackgroundBrush}" CornerRadius="8" Padding="12,7" HorizontalAlignment="Right" MaxWidth="520" VerticalAlignment="Center"><TextBlock Text="{Binding StatusMessage.Text}" Foreground="{DynamicResource StatusInfoTextBrush}" TextTrimming="CharacterEllipsis" automation:AutomationProperties.Name="{Binding StatusMessage.AccessibilityLabel}"/></Border></Grid></Border>
    </Grid>
  </Grid>
</Window>
