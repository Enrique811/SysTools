<Application x:Class="SysTools.Presentation.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SysTools.Presentation"
             xmlns:priceVerifier="clr-namespace:SysTools.Presentation.Modules.PriceVerifier.ViewModels"
             xmlns:priceVerifierViews="clr-namespace:SysTools.Presentation.Modules.PriceVerifier.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Colors.xaml" />
                <ResourceDictionary Source="Styles/Typography.xaml" />
                <ResourceDictionary Source="Styles/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type priceVerifier:PriceVerifierViewModel}">
                <priceVerifierViews:PriceVerifierView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
